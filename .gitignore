# ============================================
# Oracle-Guided Meta-PPO .gitignore
# ============================================
# Excludes all data files, model checkpoints,
# and non-source files from version control
# ============================================

# ===================
# Data Files
# ===================
# NumPy arrays
*.npy
*.npz

# CSV data files
*.csv

# Pickle files
*.pkl
*.pickle

# Joblib model files
*.joblib

# HDF5 files
*.h5
*.hdf5

# JSON data (keep config JSONs if needed)
# *.json

# ===================
# Model Checkpoints
# ===================
# Stable-Baselines3 models
*.zip

# PyTorch models
*.pt
*.pth

# TensorFlow models
*.pb
*.ckpt*
checkpoint

# ===================
# Output/Results
# ===================
# Generated plots and figures
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.pdf

# TensorBoard logs
tb_logs/
tensorboard/
**/log/

# Training logs
*.log

# ===================
# Directories to Ignore
# ===================
# Data directories
**/data/
**/benchmark_data/
**/benchmark_results/
**/results/

# Model output directories
**/oracle_guided_meta_ppo/
**/vanilla_meta_ppo/
**/meta_latest/

# ===================
# Python
# ===================
# Byte-compiled files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints/
*.ipynb

# pyenv
.python-version

# Celery
celerybeat-schedule
celerybeat.pid

# ===================
# IDE / Editor
# ===================
# VS Code
.vscode/

# PyCharm
.idea/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc

# Cursor
.cursor/

# ===================
# OS Generated
# ===================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~

# ===================
# Misc
# ===================
# Temporary files
*.tmp
*.temp
*.bak

# Archive files (except model zips already covered)
*.tar
*.tar.gz
*.rar
*.7z

# Shell scripts (keep if needed for reproducibility)
# *.sh

